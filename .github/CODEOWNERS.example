/src/platform/          @NATIVE_OWNER
/src/features/reader/   @READER_OWNER
/src/features/translation/ @TRANSLATION_OWNER
/src/features/vision/   @VISION_OWNER
/src/features/manga/    @MANGA_OWNER
/src/features/library/  @LIBRARY_OWNER
/src/features/downloads/ @DOWNLOADS_OWNER
/src/features/extensions/ @EXTENSIONS_OWNER
/src/features/settings/ @SETTINGS_OWNER
/plugins/               @NATIVE_OWNER
